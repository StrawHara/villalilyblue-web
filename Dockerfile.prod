FROM node:22-alpine AS builder
WORKDIR /app
# Build reproductible : versions figées par package-lock.json (généré avec le npm de node:22-alpine).
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
# NEXT_PUBLIC_* inlinés au build : passés en argument (le .env n'entre plus dans l'image,
# cf. .dockerignore ; le compose les reprend du .env, la CI les écrit dans le workflow).
ARG NEXT_PUBLIC_GA_ID
ENV NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
# Le serveur standalone se lance avec `node` : npm, npx, corepack et yarn de
# l'image de base ne servent pas à l'exécution (et embarquent des failles,
# dont tar, CVE-2026-59873).
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /opt/yarn-* \
           /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
# .next à nextjs : sinon le cache d'images (/app/.next/cache) n'est pas inscriptible (EACCES).
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
ENV PORT=3000
CMD ["node", "server.js"]
